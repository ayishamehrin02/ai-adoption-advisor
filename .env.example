# Copy to .env (repo root) and fill in. NEVER commit .env.
# All LLM keys are used server-side only. Nothing here may be prefixed NEXT_PUBLIC_.

# --- Supabase ---
# Project URL and anon key are safe for the browser only if RLS policies allow it.
# This project's tables have RLS on with no public policies, so all access goes
# through the server using the service-role key.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # server-only, bypasses RLS. Never expose.

# --- LLM gateway (OpenRouter) ---
# One key for the app's intake calls and for the Python benchmark.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model slug used for intake/extraction in the app. Pick a cheap model from your
# models.json; it is not hardcoded anywhere in the code.
INTAKE_MODEL=
# Model slug used as the LLM-as-judge in the benchmark (use a stronger model
# than the ones being graded where possible).
JUDGE_MODEL=

# --- Display ---
# ISO 4217 code for the currency shown in the UI. Prices are stored in USD and
# converted using the fx_rates table.
DISPLAY_CURRENCY=USD
